// Legacy Gauges tracker, modified to be cookieless.
//
// Fathom is cookieless by design. The original Gauges script stored _gauges_*
// browser cookies and reported uniqueness flags derived from them. Fathom's
// ingest (RecordHit) ignores those flags entirely and computes uniqueness
// server-side via VisitorHasher (daily-rotating salted signature), exactly like
// native Fathom traffic. So the cookies were dead weight AND a privacy
// regression.
//
// This version keeps the legacy beacon contract intact (same track.gif endpoint
// and the same site_id/resource/referrer/user_agent params that RecordHit reads)
// but no longer stores any browser cookie and no longer sends the client-derived
// uniqueness flags. Do not reintroduce cookie storage here.
//
// Beacon URL resolution, in order:
//   1. data-track-path when the embed sets it. Every modern snippet does, and it
//      always names track.gaug.es.
//   2. The script's own origin, when track.js was loaded from a *.gaug.es host.
//      This is the original Gauges behavior and it is required by
//      Content-Security-Policy: a site that embedded from secure.gaug.es
//      whitelisted THAT origin in script-src/img-src and has no reason to allow
//      track.gaug.es, so a cross-origin beacon is dropped by the browser with no
//      request and no error anyone can see. /track.gif is path-scoped
//      (routes/gauges-track.php), so the hit records on whichever gaug.es host
//      receives it.
//   3. track.gaug.es for any other origin. Older snippets load track.js from the
//      Gauges CloudFront CDN, a script-only distribution that is not a verified
//      beacon endpoint, so those embeds must not beacon at their own origin.
var _gauges=_gauges||[];(function(){var h=(_gauges['slice'])?_gauges.slice(0):[];_gauges={track_referrer:true,image:new Image(),track:function(){var a=this.url();if(a){this.image.src=a}},push:function(a){var b=a.shift();if(b=='track'){_gauges.track()}},url:function(){var a,b,f,c=this.$('gauges-tracker');if(c){b=c.getAttribute('data-site-id');f=c.getAttribute('data-track-path');if(!f){var s=String(c.src||'').split('?')[0];f=/^https?:\/\/[^\/]+\.gaug\.es\/track\.js$/.test(s)?s.replace('/track.js','/track.gif'):'https://track.gaug.es/track.gif'}a=String(f);a+="?h[site_id]="+b;a+="&h[resource]="+this.resource();a+="&h[referrer]="+this.referrer();a+="&h[title]="+this.title();a+="&h[user_agent]="+this.agent();a+="&h[screenx]="+this.screenWidth();a+="&h[browserx]="+this.browserWidth();a+="&h[browsery]="+this.browserHeight();a+="&timestamp="+this.timestamp()}return a},domain:function(){return window.location.hostname},referrer:function(){var a='';if(!this.track_referrer){return a}this.track_referrer=false;try{a=top.document.referrer}catch(e1){try{a=parent.document.referrer}catch(e2){a=''}}if(a==''){a=document.referrer}return this.escape(a)},agent:function(){return this.escape(navigator.userAgent)},escape:function(a){return(typeof(encodeURIComponent)=='function')?encodeURIComponent(a):escape(a)},resource:function(){return this.escape(document.location.href)},timestamp:function(){return new Date().getTime()},title:function(){return(document.title&&document.title!="")?this.escape(document.title):''},screenWidth:function(){try{return screen.width}catch(e){return 0}},browserDimensions:function(){var a=0,b=0;try{if(typeof(window.innerWidth)=='number'){a=window.innerWidth;b=window.innerHeight}else if(document.documentElement&&document.documentElement.clientWidth){a=document.documentElement.clientWidth;b=document.documentElement.clientHeight}else if(document.body&&document.body.clientWidth){a=document.body.clientWidth;b=document.body.clientHeight}}catch(e){}return{width:a,height:b}},browserWidth:function(){return this.browserDimensions().width},browserHeight:function(){return this.browserDimensions().height},$:function(a){if(document.getElementById){return document.getElementById(a)}return null}};_gauges.track();for(var g=0,i=h.length;g<i;g++){_gauges.push(h[g])}})();
